{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./src/*",
        "./*"
      ],
      "@/shared/*": [
        "./src/shared/*"
      ],
      "@/components/ui/*": [
        "./src/shared/ui/ui/*",
        "./src/shared/ui/*"
      ],
      "@/components/*": [
        "./src/shared/ui/*"
      ],
      "@/constants/*": [
        "./src/shared/config/*"
      ],
      "@/hooks/*": [
        "./src/shared/hooks/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
